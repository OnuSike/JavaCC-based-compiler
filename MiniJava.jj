options {
  LOOKAHEAD = 1;
  CHOICE_AMBIGUITY_CHECK = 2;
  OTHER_AMBIGUITY_CHECK = 1;
  STATIC = true;
  DEBUG_PARSER = false;
  DEBUG_LOOKAHEAD = false;
  DEBUG_TOKEN_MANAGER = false;
  ERROR_REPORTING = true;
  JAVA_UNICODE_ESCAPE = false;
  UNICODE_INPUT = false;
  IGNORE_CASE = false;
  USER_TOKEN_MANAGER = false;
  USER_CHAR_STREAM = false;
  BUILD_PARSER = true;
  BUILD_TOKEN_MANAGER = true;
  SANITY_CHECK = true;
  FORCE_LA_CHECK = false;
}

PARSER_BEGIN(MiniJava)

/** Simple brace matcher. */
public class MiniJava {

  /** Main entry point. */
  public static void main(String args[]) throws ParseException {
    MiniJava parser = new MiniJava(System.in);
    parser.Program();
    System.out.println("Parsed OK");
  }

}

PARSER_END(MiniJava)

SKIP : { " " | "\t" | "\n" | "\r" }

TOKEN : {
  < CLASS: "class" >
| < LBRACE: "{" >
| < RBRACE: "}" >
| < PUBLIC: "public" >
| < STATIC: "static" >
| < VOID: "void" >
| < MAIN: "main" >
| < STRING: "String" >
| < LPAREN: "(" >
| < RPAREN: ")" >
| < LBRACKET: "[" >
| < RBRACKET: "]" >
| < IF: "if" >
| < ELSE: "else" >
| < WHILE: "while" >
| < PRINT: "System.out.println" >
| < EXTENDS: "extends" >
| < RETURN: "return" >
| < SEMICOL: ";" >
| < COMMA: "," >
| < DOT: ".">
| < EXCL: "!" >
| < LENGTH: "length" >
| < INT: "int" >
| < BOOLEAN: "boolean" >
| < TRUE: "true" >
| < FALSE: "false" >
| < THIS: "this" >
| < NEW: "new" >
| < EQ: "=" >
| < PLUS: "+" >
| < MINUS: "-" >
| < MULT: "*" >
| < DIV: "/" >
| < AND: "&&" >
| < LT: "<" >
| < INTEGER_LITERAL: (["0"-"9"])+ >
| < IDENTIFIER: ["a"-"z","A"-"Z"] ( ["a"-"z","A"-"Z","0"-"9","_"] )* >
}

void Program() :
{}
{
  MainClass() ( ClassDecl() )* <EOF>
}

void MainClass() :
{}
{
  <CLASS> <IDENTIFIER> <LBRACE> <PUBLIC> <STATIC> <VOID> <MAIN> <LPAREN> <STRING> <LBRACKET> <RBRACKET> <IDENTIFIER> <RPAREN> <LBRACE> Statement() <RBRACE> <RBRACE>
}

void ClassDecl() :
{}
{
  LOOKAHEAD(3) <CLASS> <IDENTIFIER> <LBRACE> ( VarDecl() )* ( MethodDecl() )* <RBRACE>
| <CLASS> <IDENTIFIER> <EXTENDS> <IDENTIFIER> <LBRACE> ( VarDecl() )* ( MethodDecl() )* <RBRACE>
}

void VarDecl() :
{}
{
  Type() <IDENTIFIER> <SEMICOL>
}

void MethodDecl() :
{}
{
  <PUBLIC> Type() <IDENTIFIER> <LPAREN> FormalList() <RPAREN> <LBRACE> ( LOOKAHEAD(2) VarDecl() )* ( Statement() )* <RETURN> Exp() <SEMICOL> <RBRACE>
}

void FormalList() :
{}
{
  [ Type() <IDENTIFIER> ( FormalRest() )* ]
}

void FormalRest() : 
{}
{
  <COMMA> Type() <IDENTIFIER>
}

void Type() :
{}
{
  <INT> [ <LBRACKET> <RBRACKET> ]
| <BOOLEAN>
| <IDENTIFIER>
}

void Statement() :
{}
{
  <LBRACE> ( Statement() )* <RBRACE>
| <IF> <LPAREN> Exp() <RPAREN> Statement() <ELSE> Statement()
| <WHILE> <LPAREN> Exp() <RPAREN> Statement()
| <PRINT> <LPAREN> Exp() <RPAREN> <SEMICOL>
| LOOKAHEAD(2) <IDENTIFIER> <EQ> Exp() <SEMICOL>
| <IDENTIFIER> <LBRACKET> Exp() <RBRACKET> <EQ> Exp() <SEMICOL>
}

void Exp() :
{}
{
  PrimaryExp() ( Op() PrimaryExp() | <LBRACKET> Exp() <RBRACKET> | LOOKAHEAD(2) <DOT> <LENGTH> | <DOT> <IDENTIFIER> <LPAREN> ExpList() <RPAREN> )*
}

void PrimaryExp() :
{}
{
  <INTEGER_LITERAL>
| <TRUE>
| <FALSE>
| <IDENTIFIER>
| <THIS>
| LOOKAHEAD(2) <NEW> <INT> <LBRACKET> Exp() <RBRACKET>
| <NEW> <IDENTIFIER> <LPAREN> <RPAREN>
| <EXCL> PrimaryExp()
| <LPAREN> Exp() <RPAREN>
}

void Op() :
{}
{
  <PLUS>
| <MINUS>
| <MULT>
| <DIV>
| <AND>
| <LT>
}

void ExpList() :
{}
{
  [ Exp() ( ExpRest() )* ]
}

void ExpRest() :
{}
{
  <COMMA> Exp()
}